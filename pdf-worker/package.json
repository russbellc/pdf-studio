{
  "name": "pdf-studio-worker",
  "version": "1.0.0",
  "type": "module",
  "description": "Microservicio de generación pixel-perfect de PDFs con Playwright y sellado criptográfico con pdf-lib",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.50.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
